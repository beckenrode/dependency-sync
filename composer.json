{
    "name": "beckenrode/dependency-sync",
    "description": "Report Composer and npm dependencies from Laravel, WordPress, and any Composer project.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/beckenrode/dependency-sync",
    "support": {
        "issues": "https://github.com/beckenrode/dependency-sync/issues",
        "source": "https://github.com/beckenrode/dependency-sync"
    },
    "require": {
        "php": "^8.1",
        "composer-runtime-api": ">=2.2",
        "ext-json": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|>=11.0",
        "phpunit/phpunit": ">=10.0"
    },
    "autoload": {
        "files": ["src/wordpress-bootstrap.php"],
        "psr-4": {
            "DependencySync\\": "src/"
        }
    },
    "bin": ["bin/dependency-sync"],
    "suggest": {
        "illuminate/console": "Required for the Laravel Artisan integration.",
        "illuminate/support": "Required for Laravel package auto-discovery."
    },
    "autoload-dev": {
        "psr-4": {
            "DependencySync\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DependencySync\\DependencySyncServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
